{
  "name": "LickPick",
  "short_name": "LickPick",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "description": "Keep the licks. Kill the flubs. Sorts your jam videos, cuts the mistakes, makes shorts.",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0912",
  "theme_color": "#0B0912",
  "icons": [
    {
      "src": "icon-192-v2.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "videos",
          "accept": [
            "video/*"
          ]
        }
      ]
    }
  }
}